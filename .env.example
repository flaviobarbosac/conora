POSTGRES_DB=conora
POSTGRES_USER=conora
POSTGRES_PASSWORD=conora_dev_password

ASPNETCORE_ENVIRONMENT=Development

OTEL_EXPORTER_OTLP_ENDPOINT=

# Google OAuth client id (id_token audience). Maps to Google:ClientId.
# Google__ClientId=

# Sign in with Apple audiences. Maps to Apple:ClientId (bundle iOS) and Apple:ServicesId (web).
# Apple__ClientId=br.com.conora.app
# Apple__ServicesId=br.com.conora.web

# JWT signing key, at least 32 chars. Maps to Jwt:Key. Never commit the real value.
# Jwt__Key=

# Gemini server-side API key (optional). Without it the app runs with the AI assistant disabled.
# Gemini__ApiKey=

# WhatsApp Cloud API (optional). VerifyToken is checked on webhook subscription;
# AppSecret validates X-Hub-Signature-256 (required outside Development).
# WhatsApp__VerifyToken=
# WhatsApp__AppSecret=
