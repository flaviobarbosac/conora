}

# Public site at apex and www; SPA under /app/; API fallback for other paths.
conora.com.br, www.conora.com.br {
	encode zstd gzip

	# Universal Links (iOS) + App Links (Android) — must stay on the apex hosts.
	handle /.well-known/apple-app-site-association {
		root * /srv/public
		header Content-Type application/json
		rewrite * /.well-known/apple-app-site-association
		file_server
	}

	handle /.well-known/assetlinks.json {
		root * /srv/public
		header Content-Type application/json
		file_server
	}

	handle /privacidade/ {
		redir /privacidade permanent
	}

	handle /termos/ {
		redir /termos permanent
	}

	handle /privacidade {
		root * /srv/public
		rewrite * /privacidade.html
		file_server
	}

	handle /termos {
		root * /srv/public
		rewrite * /termos.html
		file_server
	}

	handle /site.css {
		root * /srv/public
		file_server
	}

	# E-mail links opened in a browser (Gmail, Chrome, etc.): serve a static
	# handoff to conora:// so the SPA/PWA never burns the token. Native App /
	# Universal Links open the app directly and never hit this. ?web=1 continues
	# in the SPA for users who explicitly choose the browser.
	@emailAppHandoff {
		path /app/validar-email /app/redefinir-senha
		not query web=1
	}
	handle @emailAppHandoff {
		root * /srv/public
		rewrite * /email-app-handoff.html
		header Cache-Control "no-store"
		file_server
	}

	handle_path /app* {
		root * /srv/app
		try_files {path} /index.html
		file_server
	}

	handle / {
		root * /srv/public
		try_files /index.html
		file_server
	}

	handle {
		reverse_proxy conora-api:8080 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}
}

# API: https://api.conora.com.br
api.conora.com.br {
	encode zstd gzip

	reverse_proxy conora-api:8080 {
		flush_interval -1
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
}
